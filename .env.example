# Chameleon Honeypot — Environment Configuration
# Copy to .env and uncomment/edit as needed.
# All variables are prefixed with CHAMELEON_.

# Target IoT device
# CHAMELEON_IOT_HOST=192.168.1.1
# CHAMELEON_IOT_HTTP_PORT=80

# Honeypot listen ports
# CHAMELEON_HTTP_PORT=8080
# CHAMELEON_TELNET_PORT=23
# CHAMELEON_SSH_PORT=22

# Bind address for all servers
# CHAMELEON_BIND_HOST=0.0.0.0

# Log directory (leave unset for auto-resolution)
# CHAMELEON_LOG_DIR=/var/log/chameleon
